export default function SetlistNomad(){
  const [isLoggedIn,setIsLoggedIn]=useState(false);
  const [activeTab,setActiveTab]=useState("hub");
  const [currentArtist,setCurrentArtist]=useState("Ariana Grande");
  const [appLanguage,setAppLanguage]=useState("English");
  const [currency,setCurrency]=useState("EUR");
  const [displayCurrency,setDisplayCurrency]=useState("GBP");
  const [fontScale,setFontScale]=useState(false);
  const [distanceUnit,setDistanceUnit]=useState("miles");
  const [toast,setToast]=useState("");

  const t=DICT[appLanguage];
  const theme=THEMES[currentArtist];
  const baseText=theme.dark?"#F8FAFC":"#0F172A";
  const subText=theme.dark?"#CBD5E1":"#334155";
  const showToast=(m)=>{setToast(m);setTimeout(()=>setToast(""),2200);};

  /* members (customizable) — exclusions, avoid-crowds & allergy are per profile */
  const [members,setMembers]=useState([
    {id:"m1",name:"Yasmine",avatar:"🎤",interests:["K-Pop Fandom","Pop Music","Streetwear Fashion"],exclusions:["Tate Modern","Borough Market"],avoidCrowds:true,avoidRestaurants:false,allergy:""},
    {id:"m2",name:"Mother",avatar:"🌿",interests:["Botanical Gardens","Gastronomy & Cooking"],exclusions:["Camden Lock Stalls"],avoidCrowds:false,avoidRestaurants:true,allergy:"Shellfish"},
    {id:"m3",name:"Brother",avatar:"🎮",interests:["Gaming Cafés","Football Stadium Tours","Esports Venues"],exclusions:[],avoidCrowds:true,avoidRestaurants:false,allergy:""},
  ]);
  const [addingFor,setAddingFor]=useState(null);
  const [avatarPicker,setAvatarPicker]=useState(null);

  /* budget */
  const [extras,setExtras]=useState({tickets:[],stay:[],food:[],activities:[],transport:[]});
  const [openExtra,setOpenExtra]=useState(null);
  const [openPartner,setOpenPartner]=useState(null);
  const [extraInput,setExtraInput]=useState({label:"",amount:""});
  const [capUSD,setCapUSD]=useState(2800);

  /* live FX rates (vs USD), refreshed daily from a free no-key API */
  const [rates,setRates]=useState(null);
  const [ratesDate,setRatesDate]=useState("");

  const [mapsApiKey,setMapsApiKey]=useState("");
  const [creds,setCreds]=useState({user:"Yasmine",email:"yasmine.faddel@essec.edu",pwd:"••••••••••••"});

  useEffect(()=>{
    const id="sln-font-link";
    if(!document.getElementById(id)){
      const l=document.createElement("link");
      l.id=id;l.rel="stylesheet";
      l.href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap";
      document.head.appendChild(l);
    }
    const codes=Object.keys(CURRENCIES);
    const build=(get)=>{const m={USD:1};codes.filter(c=>c!=="USD").forEach(c=>{const v=get(c);if(v)m[c]=v;});return m;};
    const load=()=>fetch("https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/usd.json")
      .then(r=>r.json())
      .then(d=>{const u=d.usd||{};setRates(build(c=>u[c.toLowerCase()]));setRatesDate(d.date||new Date().toISOString().slice(0,10));})
      .catch(()=>fetch("https://open.er-api.com/v6/latest/USD").then(r=>r.json()).then(d=>{const u=d.rates||{};setRates(build(c=>u[c]));setRatesDate((d.time_last_update_utc||"").slice(0,16));}).catch(()=>{}));
    load();
    const rid=setInterval(load,300000); // refresh every 5 min
    return ()=>clearInterval(rid);
  },[]);

  if(!isLoggedIn) return <LoginScreen t={t} onLogin={()=>setIsLoggedIn(true)}/>;

  const tabs=[
    {id:"hub",label:t.tab_hub,icon:"◎"},
    {id:"profiles",label:t.tab_profiles,icon:"❖"},
    {id:"budget",label:t.tab_budget,icon:"◑"},
    {id:"itinerary",label:t.tab_itinerary,icon:"▦"},
    {id:"settings",label:t.tab_settings,icon:"⚙"},
  ];

  return (
    <PhoneFrame>
      <GlobalStyle/>
      <div style={{position:"absolute",inset:0,background:theme.screen}}/>
      <JoyfulBG accent={theme.accent}/>
      <div style={{position:"relative",zIndex:10,height:44,flexShrink:0,display:"flex",alignItems:"center",justifyContent:"space-between",padding:"0 18px",color:baseText,fontWeight:700,fontSize:12,background:theme.dark?"rgba(0,0,0,.25)":"rgba(255,255,255,.45)",backdropFilter:"blur(8px)"}}>
        <span style={{fontWeight:900,letterSpacing:0.3,fontSize:10.5,whiteSpace:"nowrap"}}>SETLIST NOMAD</span>
        <span style={{display:"flex",alignItems:"center",gap:8}}><Clock/><span>5G</span></span>
      </div>

      <div className="custom-scrollbar" style={{position:"relative",zIndex:5,flex:1,overflowY:"auto",overflowX:"hidden",padding:"16px 16px 112px",color:baseText}}>
        <div style={{zoom:fontScale?1.18:1}}>
          {activeTab==="hub"&&<HubTab {...{t,theme,baseText,subText,currency}}/>}
          {activeTab==="profiles"&&<ProfilesTab {...{t,theme,baseText,subText,currentArtist,setCurrentArtist,members,setMembers,addingFor,setAddingFor,setAvatarPicker,mapsApiKey}}/>}
          {activeTab==="budget"&&<BudgetTab {...{t,theme,baseText,subText,currency,setCurrency,displayCurrency,setDisplayCurrency,extras,setExtras,openExtra,setOpenExtra,openPartner,setOpenPartner,extraInput,setExtraInput,capUSD,setCapUSD,rates,ratesDate}}/>}
          {activeTab==="itinerary"&&<ItineraryTab {...{t,theme,baseText,subText,distanceUnit,members,mapsApiKey}}/>}
          {activeTab==="settings"&&<SettingsTab {...{t,theme,baseText,subText,appLanguage,setAppLanguage,currency,setCurrency,fontScale,setFontScale,distanceUnit,setDistanceUnit,creds,setCreds,showToast,setIsLoggedIn,mapsApiKey,setMapsApiKey}}/>}
        </div>
      </div>

      {avatarPicker&&(
        <div onClick={()=>setAvatarPicker(null)} style={{position:"absolute",inset:0,zIndex:70,background:"rgba(0,0,0,.55)",display:"flex",alignItems:"center",justifyContent:"center",padding:24}}>
          <div onClick={(e)=>e.stopPropagation()} className="custom-scrollbar" style={{background:"#fff",borderRadius:22,padding:18,width:"100%",boxShadow:"0 20px 50px rgba(0,0,0,.4)",maxHeight:360,overflowY:"auto"}}>
            <p style={{fontWeight:800,color:"#0F172A",marginBottom:12,fontSize:14}}>{t.ui_choose_avatar}</p>
            <div style={{display:"grid",gridTemplateColumns:"repeat(5,1fr)",gap:8}}>
              {AVATAR_CHOICES.map(a=>(
                <button key={a} onClick={()=>{setMembers(p=>p.map(m=>m.id===avatarPicker?{...m,avatar:a}:m));setAvatarPicker(null);}} style={{fontSize:24,padding:"9px 0",borderRadius:12,cursor:"pointer",border:"2px solid #E2E8F0",background:"#F8FAFC"}}>{a}</button>
              ))}
            </div>
          </div>
        </div>
      )}

      <Toast msg={toast}/>

      <div style={{position:"absolute",bottom:0,left:0,right:0,zIndex:40,display:"flex",justifyContent:"space-around",alignItems:"center",padding:"10px 6px 14px",background:theme.dark?"rgba(12,15,20,.92)":"rgba(255,255,255,.92)",backdropFilter:"blur(14px)",borderTop:`1px solid ${theme.dark?"#2A2F36":"#E5E7EB"}`}}>
        {tabs.map(tab=>{
          const on=activeTab===tab.id;
          return (
            <button key={tab.id} onClick={()=>setActiveTab(tab.id)} style={{border:"none",background:"transparent",cursor:"pointer",display:"flex",flexDirection:"column",alignItems:"center",gap:3,flex:1,padding:0}}>
              <span style={{fontSize:18,width:38,height:30,lineHeight:"30px",borderRadius:12,color:on?theme.headerText:"#94A3B8",background:on?theme.accent:"transparent",transition:"all .2s"}}>{tab.icon}</span>
              <span style={{fontSize:9.5,fontWeight:on?800:600,color:on?(theme.dark?"#fff":"#0F172A"):"#94A3B8"}}>{tab.label}</span>
            </button>
          );
        })}
      </div>
    </PhoneFrame>
  );
}

/* ---------- frame / bg ---------- */
function PhoneFrame({children}){
  return (
    <div className="sln-root" style={{display:"flex",justifyContent:"center",background:"#0B0F17",minHeight:"100%",padding:"16px 0",fontFamily:FONT}}>
      <div style={{width:390,height:780,margin:"16px auto",background:"#fff",boxShadow:"0 30px 80px rgba(0,0,0,.6)",borderRadius:40,border:"12px solid #0F172A",display:"flex",flexDirection:"column",justifyContent:"space-between",overflow:"hidden",position:"relative",fontFamily:FONT}}>
        <div style={{position:"absolute",top:0,left:"50%",transform:"translateX(-50%)",width:130,height:26,background:"#0F172A",borderRadius:"0 0 16px 16px",zIndex:100}}/>
        {children}
      </div>
    </div>
  );
}
function GlobalStyle(){
  return <style>{`
    @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap');
    .sln-root, .sln-root *{font-family:${FONT} !important;}
    .custom-scrollbar::-webkit-scrollbar{width:5px;}
    .custom-scrollbar::-webkit-scrollbar-thumb{background:rgba(120,120,140,.45);border-radius:9px;}
    .custom-scrollbar::-webkit-scrollbar-track{background:transparent;}
    @keyframes floatA{0%,100%{transform:translate(0,0) rotate(0)}50%{transform:translate(14px,-18px) rotate(8deg)}}
    @keyframes floatB{0%,100%{transform:translate(0,0)}50%{transform:translate(-16px,12px)}}
    @keyframes auraShift{0%,100%{transform:translate(0,0) scale(1);opacity:.7}50%{transform:translate(20px,-24px) scale(1.15);opacity:.45}}
    @keyframes beam{0%,100%{opacity:.25;transform:rotate(var(--r)) scaleY(1)}50%{opacity:.6;transform:rotate(var(--r)) scaleY(1.08)}}
    @keyframes dashmove{to{stroke-dashoffset:-16}}
  `}</style>;
}
function Clock(){
  const [now,setNow]=useState(new Date());
  useEffect(()=>{const id=setInterval(()=>setNow(new Date()),1000);return()=>clearInterval(id);},[]);
  return <span>{now.toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"})}</span>;
}
function JoyfulBG({accent="#8B5CF6"}){
  return (
    <div style={{position:"absolute",inset:0,overflow:"hidden",zIndex:1,pointerEvents:"none"}}>
      <div style={{position:"absolute",top:-40,right:-30,width:180,height:180,borderRadius:"50%",background:`radial-gradient(circle, ${accent}55, transparent 70%)`,filter:"blur(10px)",animation:"auraShift 9s ease-in-out infinite"}}/>
      <div style={{position:"absolute",bottom:120,left:-40,width:200,height:200,borderRadius:"50%",background:`radial-gradient(circle, #7AB7FF45, transparent 70%)`,filter:"blur(12px)",animation:"auraShift 11s ease-in-out 1s infinite"}}/>
      <div style={{position:"absolute",top:120,left:24,fontSize:70,opacity:0.05,animation:"floatA 12s ease-in-out infinite"}}>𝄞</div>
      <div style={{position:"absolute",bottom:220,right:30,fontSize:90,opacity:0.05,animation:"floatB 14s ease-in-out infinite"}}>𝄞</div>
      <div style={{position:"absolute",top:320,right:60,fontSize:26,opacity:0.12,animation:"floatA 10s ease-in-out infinite"}}>✦</div>
      <div style={{position:"absolute",top:200,left:70,fontSize:18,opacity:0.12,animation:"floatB 8s ease-in-out infinite"}}>✦</div>
    </div>
  );
}

